          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Settings" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功 code=0 + data 为完整设置对象；空对象 code=1「没有可保存的设置项」；themeColor 非 #RRGGBB code=1",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/RespBase" },
                    { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/Settings" } } }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/settings/reset": {
      "post": {
        "tags": ["Settings"],
        "summary": "恢复默认设置",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/RespBase" },
                    { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/Settings" } } }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
