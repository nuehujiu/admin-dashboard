# 服务配置
PORT=3000
# 只监听本机，由 Nginx 反代对外；需要局域网直连时改成 0.0.0.0
HOST=127.0.0.1
# development / production（生产会隐藏 500 详情、开启登录限流、要求强密钥）
NODE_ENV=development

# MySQL 数据库配置
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=admin_dashboard

# JWT 配置（生产环境务必修改为随机强密钥：openssl rand -hex 32）
JWT_SECRET=please_change_this_to_a_long_random_secret
JWT_EXPIRES_IN=2h

# 允许跨域的来源（多个用英文逗号分隔；生产改成实际域名）
CORS_ORIGIN=http://localhost:5173

# 日志级别 debug / info / warn / error
LOG_LEVEL=info
# 登录限流：生产默认开启；本地调试可设 LOGIN_RATE_LIMIT=off 关闭
# LOGIN_RATE_LIMIT=on
LOGIN_RATE_LIMIT_MAX=8

# 初始化数据库时的账号密码（npm run init-db）
# 生产环境必须显式设置且不少于 12 位
# SEED_PASSWORD=
